# Copy to `.env` and fill in values from your LNbits + Nostr setup.
# Dev server: npm run dev  →  http://localhost:3001 (override PORT below)

# --- HTTP server ---
PORT=3001

# Public game URL for join/spectate links in ONLINE Nostr Kind1 notes (no trailing slash)
GAME_PUBLIC_URL=https://game.chainduel.net

# --- LNbits (required for LNURL pay/withdraw and bounty zaps) ---
LNBITS_URL=https://your-lnbits.example.com
LNBITS_KEY=your-lnbits-admin-or-invoice-key
# Shared secret LNbits sends as the X-Webhook-Secret header on deposit and withdraw webhooks.
# Required. A missing or wrong value makes both webhooks return 403, so deposits are not credited.
# New LNURL links include this header automatically. Recreate links created before this secret,
# or set their LNbits webhook headers to {"X-Webhook-Secret":"<this value>"}.
LNBITS_WEBHOOK_SECRET=change-me
# Public URLs LNbits calls when a deposit is paid or withdrawal completes
LNBITS_DEPOSITHOOK=https://your-host.example.com/api/LNURL/paid
LNBITS_WITHDRAWHOOK=https://your-host.example.com/api/LNURL/withdrawn

# --- Nostr (Kind1 publish, zap receipts, challenge bounty payouts) ---
# nsec… or 64-char hex secret for the server NDK signer / NIP-57 zap payer
NOSTR_PK=nsec1...

# --- Lightning addresses (LNURL-pay metadata / fee splits) ---
# Fallback host LUD-16 when kind-1 metadata has no address (anonymous seat zap path)
HOST_LNADDRESS=host@wallet.example.com
# Optional revenue split on non-ONLINE LNURLP payments
DEVELOPER_LNADDRESS=
DESIGNER_LNADDRESS=

# --- Mempool block bonuses (ONLINE rooms) ---
# Optional override / preferred host (mirrors tried after this if it fails)
# MEMPOOL_HOST=https://mempool.emzy.de

# --- Admin ---
ADMIN_PASSWORD=change-me
# Set to true to enable GET /dashboard/api/debug/raw (dumps live sessions and LNURL ids).
# DASHBOARD_DEBUG_RAW=true

# --- Traffic analytics (dashboard Overview) ---
# Salt for daily IP hashing (unique visitor counts); change in production
TRAFFIC_SALT=change-me-in-production
# Days to keep country rollup on disk (default 7)
TRAFFIC_ROLLUP_RETENTION_DAYS=7

# --- Challenge bounties (practice mode) ---
# Hex pubkey of @chainduel — users must follow in kind-3
# npub1kd3nlw09ufkgmts2kaf0x8m4mq57exn6l8rz50v5ngyr2h3j5cfswdsdth
CHAINDUEL_NOSTR_PUBKEY=
# Max sats paid out across all challenge bounties per calendar day (default 100000)
CHALLENGE_BOUNTY_DAILY_CAP_SATS=100000
# Per socket session, rolling 1-minute window (defaults: 12 runs, 30 win submits)
CHALLENGE_RUN_RATE_LIMIT_PER_MIN=12
CHALLENGE_SUBMIT_RATE_LIMIT_PER_MIN=30
# Socket abuse caps, per session and per public IP, rolling 1-minute window.
# Room create 3, seat invoices (Lightning + zap pay) 6, new LNbits pay links 6.
ROOM_CREATE_RATE_LIMIT_PER_MIN=3
SEAT_INVOICE_RATE_LIMIT_PER_MIN=6
LNURL_CREATE_RATE_LIMIT_PER_MIN=6
